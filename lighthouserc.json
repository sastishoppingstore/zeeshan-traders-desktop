{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:3000/", "http://127.0.0.1:3000/products", "http://127.0.0.1:3000/erp/login"],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop", "throttlingMethod": "simulate", "onlyCategories": ["performance", "accessibility", "best-practices", "seo", "pwa"] }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    }
  }
}
