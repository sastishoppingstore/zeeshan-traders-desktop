{
  "name": "zeeshan-traders",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Zeeshan Traders (ذیشان ٹریڈرز) — public Urdu catalogue + fertilizer-centre ERP/Khata on Cloudflare Workers + D1 + R2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build:web && tsx apps/worker/src/server/node-server.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:desktop": "cross-env BUILD_TARGET=desktop vite build --config apps/web/vite.config.ts",
    "config:desktop": "node scripts/write-desktop-config.mjs",
    "icon:desktop": "node scripts/build-desktop-icon.mjs",
    "dev:desktop": "npm run build:desktop && node scripts/write-desktop-config.mjs && cross-env NODE_ENV=development DESKTOP_API_URL=http://localhost:3000 electron .",
    "dist:win": "npm run build:desktop && node scripts/write-desktop-config.mjs --required && electron-builder --win nsis --x64",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "build:images": "node scripts/build-images.mjs",
    "preview": "npm run build:web && tsx apps/worker/src/server/node-server.ts",
    "server": "tsx apps/worker/src/server/node-server.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate:local": "tsx apps/worker/src/server/migrate.ts",
    "deploy:staging": "wrangler deploy -c wrangler.v2.jsonc --env staging",
    "deploy:production": "wrangler deploy -c wrangler.v2.jsonc --env production",
    "d1:staging": "wrangler d1 migrations apply zt-v2-staging --remote -c wrangler.v2.jsonc --env staging",
    "d1:production": "wrangler d1 migrations apply zt-v2-production --remote -c wrangler.v2.jsonc --env production",
    "seed:generate": "tsx scripts/gen-seed.ts",
    "query:plan": "tsx scripts/check-query-plans.ts",
    "restore": "tsx scripts/restore.ts",
    "check:all": "npm run typecheck && npm test && npm run query:plan && npm run build:web",
    "e2e:passkeys": "node scripts/e2e-passkeys.mjs",
    "e2e:pin": "node scripts/e2e-pin.mjs",
    "test:visual": "node scripts/visual-baselines.mjs",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test:a11y": "node scripts/a11y.mjs",
    "test:print": "tsx scripts/print-proof.tsx",
    "test:browser": "npm run e2e:passkeys && npm run e2e:pin && npm run test:visual && npm run test:a11y && npm run test:print && npm run test:lighthouse",
    "deploy:dryrun": "wrangler deploy --dry-run -c wrangler.v2.jsonc --env staging && wrangler deploy --dry-run -c wrangler.v2.jsonc --env production",
    "docs:features": "node scripts/features-doc.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-naskh-arabic": "^5.2.8",
    "@fontsource/noto-nastaliq-urdu": "^5.2.8",
    "@hono/node-server": "^1.19.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "^5.90.0",
    "better-sqlite3": "^13.0.3",
    "dexie": "^4.2.0",
    "hono": "^4.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "lighthouse": "^13.6.0",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  },
  "build": {
    "appId": "com.zeeshantraders.desktop",
    "productName": "Zeeshan Traders",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "migrations/*.sql",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**"
    ],
    "npmRebuild": true,
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ZeeshanTraders-${version}-win-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Zeeshan Traders",
      "uninstallDisplayName": "Zeeshan Traders ${version}",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    }
  },
  "electronBuilderSigningPlaceholder": {
    "_note": "Code signing is intentionally OFF (no cert, no secrets in Git). To enable: move the keys below into package.json > build.win.signtoolOptions — electron-builder v26 rejects win.certificateFile at the win level and its config schema forbids unknown/comment keys, so this inert field is the disabled placeholder. Supply the certificate out of band via CSC_LINK/CSC_KEY_PASSWORD (or a Windows store subject name); never commit a .pfx or a password.",
    "signtoolOptions": {
      "certificateFile": "REPLACE_WITH_PATH_TO_PFX",
      "certificateSubjectName": "CN=Zeeshan Traders",
      "publisherName": "Zeeshan Traders"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "electron": true,
    "better-sqlite3": true,
    "workerd@1.20251011.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.25.4": true
  }
}
